+        private fun getIdentifier(element: KtSourceElement): KtSourceElement {
+            val tree = element.treeStructure
+            var node = element.lighterASTNode
+            // Type references wrap their name; do not descend into type arguments
+            // or a qualified type's receiver when selecting the referenced identifier.
+            while (true) {
+                val type =
+                    when (node.tokenType) {
+                        KtNodeTypes.TYPE_REFERENCE ->
+                            if (tree.findChildByType(node, KtNodeTypes.NULLABLE_TYPE) != null)
+                                KtNodeTypes.NULLABLE_TYPE
+                            else KtNodeTypes.USER_TYPE
+                        KtNodeTypes.NULLABLE_TYPE -> KtNodeTypes.USER_TYPE
+                        KtNodeTypes.USER_TYPE -> KtNodeTypes.REFERENCE_EXPRESSION
+                        else -> break
+                    }
+                node = tree.findChildByType(node, type) ?: break
+            }
+            return tree.findChildByType(node, KtTokens.IDENTIFIER)?.toKtLightSourceElement(tree)
+                ?: element
+        }
     }
 
