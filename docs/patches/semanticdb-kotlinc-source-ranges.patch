     @Test
+    fun `generic supertype and delegated property references use source identifiers`(
+        @TempDir path: Path
+    ) {
+        val document =
+            compileSemanticdb(
+                path,
+                """
+            package fixture
+            open class Base<T>
+            class Child : fixture.Base<String>() {
+                val annotations: Set<String> by lazy {
+                    emptySet<String>()
+                }
+                fun read() = annotations
+            }
+        """
+                    .trimIndent(),
+            )
+        val lines = document.text.lines()
+        val references = document.occurrencesList.filter { it.role == Role.REFERENCE }
+        val base = references.filter { it.symbol == "fixture/Base#" }
+        kotlin.test.assertTrue(base.isNotEmpty())
+        for (occurrence in base) {
+            val range = occurrence.range
+            range.startLine shouldBe range.endLine
+            lines[range.startLine].substring(range.startCharacter, range.endCharacter) shouldBe
+                "Base"
+        }
+        val property = references.filter { it.symbol == "fixture/Child#annotations." }
+        kotlin.test.assertTrue(property.isNotEmpty())
+        for (occurrence in property) {
+            val range = occurrence.range
+            range.startLine shouldBe range.endLine
+            lines[range.startLine].substring(range.startCharacter, range.endCharacter) shouldBe
+                "annotations"
+        }
+        kotlin.test.assertTrue(references.any { it.symbol == "kotlin/lazy()." })
+        val readDefinition =
+            document.occurrencesList
+                .single { it.symbol == "fixture/Child#read()." && it.role == Role.DEFINITION }
+                .range
+        lines[readDefinition.startLine].substring(
+            readDefinition.startCharacter,
+            readDefinition.endCharacter,
+        ) shouldBe "read"
+    }
