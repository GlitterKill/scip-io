+package com.sourcegraph.gradle.semanticdb
+
+import java.io.File
+import java.nio.charset.StandardCharsets.UTF_8
+import java.nio.file.{Files, StandardCopyOption}
+import java.{util => ju}
+import scala.jdk.CollectionConverters._
+import scala.language.reflectiveCalls
+import com.sourcegraph.scip_java.BuildInfo
+import org.gradle.api.{DefaultTask, GradleException}
+import org.gradle.api.tasks.TaskAction
+import org.gradle.internal.service.ServiceRegistry
+import org.gradle.tooling.provider.model.ToolingModelBuilderRegistry
+
+/**
+ * Script compilation is separate from KotlinCompile, including when Gradle has
+ * cached scripts.
+ */
+class CompileKotlinDslScripts extends DefaultTask {
+  @TaskAction
+  def compileScripts(): Unit = {
+    val project = getProject
+    val root = project.getRootDir.toPath.toRealPath()
+    val hasScripts =
+      project
+        .getAllprojects
+        .asScala
+        .exists(_.getBuildFile.getName.endsWith(".gradle.kts")) ||
+        Files.isRegularFile(root.resolve("settings.gradle.kts"))
+    if (!hasScripts)
+      return
+
+    type ScriptModel = {
+      def getClassPath(): ju.List[File]
+      def getImplicitImports(): ju.List[String]
+      def getExceptions(): ju.List[String]
+    }
+    type ScriptsModel = {
+      def getScriptModels(): ju.Map[File, ScriptModel]
+    }
+    val services = project
+      .asInstanceOf[{
+        def getServices(): ServiceRegistry
+      }]
+      .getServices()
+    val modelName = "org.gradle.tooling.model.kotlin.dsl.KotlinDslScriptsModel"
+    val model = services
+      .get(classOf[ToolingModelBuilderRegistry])
+      .getBuilder(modelName)
+      .buildAll(modelName, project)
+      .asInstanceOf[ScriptsModel]
+    val scripts = model
+      .getScriptModels()
+      .asScala
+      .toList
+      .filter { case (file, _) =>
+        file.toPath.toRealPath().startsWith(root)
+      }
+      .sortBy(_._1.toString)
+    if (scripts.isEmpty)
+      throw new GradleException("No Kotlin DSL script models returned")
+
+    val lib = new File(project.getGradle.getGradleHomeDir, "lib")
+    val jars = Option(lib.listFiles())
+      .toList
+      .flatten
+      .filter(_.getName.endsWith(".jar"))
+    def pluginJar(prefix: String): String =
+      jars
+        .find(_.getName.startsWith(prefix))
+        .getOrElse(
+          throw new GradleException(
+            s"Missing Gradle embedded compiler component: $prefix"
+          )
+        )
+        .toString
+    val assignment = pluginJar("kotlin-assignment-compiler-plugin-")
+    val sam = pluginJar("kotlin-sam-with-receiver-compiler-plugin-")
+    val dependency = project
+      .getDependencies
+      .create(
+        s"com.sourcegraph:semanticdb-kotlinc:${BuildInfo
+            .semanticdbKotlincVersion}"
+      )
+    val config = project.getConfigurations.detachedConfiguration(dependency)
+    config.setTransitive(false)
+    val semanticdb = config.getSingleFile.toString
+    val target =
+      new File(
+        project
+          .getExtensions
+          .getExtraProperties
+          .get("semanticdbTarget")
+          .toString
+      ).toPath
+    val work = getTemporaryDir.toPath
+    Files.createDirectories(work)
+    val source = work.resolve("ScipGradleScript.kt")
+    val resource = getClass.getResourceAsStream("/ScipGradleScript.kt")
+    if (resource == null)
+      throw new GradleException("Missing SCIP Kotlin DSL compiler helper")
+    try Files.copy(resource, source, StandardCopyOption.REPLACE_EXISTING)
+    finally resource.close()
+    val bridge = work.resolve("script-compiler.jar")
+    val java =
+      new File(
+        System.getProperty("java.home"),
+        "bin/java" +
+          (if (File.separatorChar == '\\')
+             ".exe"
+           else
+             "")
+      ).toString
+    val runtimeClasspath = new File(lib, "*").toString
+    def run(args: List[String]): Unit = {
+      val process =
+        new ProcessBuilder(
+          (
+            List(java, "-cp", runtimeClasspath + File.pathSeparator + bridge) ++
+              args
+          ).asJava
+        ).directory(project.getRootDir).redirectErrorStream(true).start()
+      try {
+        val output = scala
+          .io
+          .Source
+          .fromInputStream(process.getInputStream, "UTF-8")
+        try output.getLines().foreach(line => getLogger.lifecycle(line))
+        finally output.close()
+        val exit = process.waitFor()
+        if (exit != 0)
+          throw new GradleException(
+            s"SCIP Kotlin DSL compiler failed (exit $exit)"
+          )
+      } catch {
+        case interrupted: InterruptedException =>
+          process.destroyForcibly()
+          Thread.currentThread().interrupt()
+          throw interrupted
+      }
+    }
+    // Use an argument file so Windows command-line limits do not depend on Gradle's install path.
+    def quote(value: String): String =
+      "\"" + value.replace("\\", "\\\\").replace("\"", "\\\"") + "\""
+    val compilerArgs = List(
+      "-no-stdlib",
+      "-no-reflect",
+      "-classpath",
+      jars.mkString(File.pathSeparator),
+      "-d",
+      bridge.toString,
+      source.toString
+    )
+    val argfile = work.resolve("compiler.args")
+    Files.write(argfile, compilerArgs.map(quote).asJava, UTF_8)
+    run(List("org.jetbrains.kotlin.cli.jvm.K2JVMCompiler", "@" + argfile))
+
+    scripts
+      .zipWithIndex
+      .foreach { case ((file, script), number) =>
+        if (!script.getExceptions().isEmpty)
+          throw new GradleException(
+            s"Failed to resolve script model for $file: ${script
+                .getExceptions()}"
+          )
+        val imports = work.resolve(s"$number.imports")
+        val classpath = work.resolve(s"$number.classpath")
+        Files.write(imports, script.getImplicitImports(), UTF_8)
+        Files.write(
+          classpath,
+          script.getClassPath().asScala.map(_.toString).asJava,
+          UTF_8
+        )
+        val relative = root.relativize(file.toPath.toRealPath())
+        val output = target
+          .resolve("META-INF/semanticdb")
+          .resolve(relative.toString + ".semanticdb")
+        // Old output must not satisfy this run's proof, even when normal Gradle scripts are cached.
+        Files.deleteIfExists(output)
+        getLogger.lifecycle(s"SCIP Kotlin DSL: $relative")
+        run(
+          List(
+            "ScipGradleScriptKt",
+            file.toString,
+            imports.toString,
+            classpath.toString,
+            semanticdb,
+            root.toString,
+            target.toString,
+            assignment,
+            sam
+          )
+        )
+        if (!Files.isRegularFile(output) || Files.size(output) == 0)
+          throw new GradleException(
+            s"Compiler produced no SemanticDB for $relative"
+          )
+      }
+  }
+}
