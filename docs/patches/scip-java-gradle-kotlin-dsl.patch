+import com.sourcegraph.Scip;
+import java.nio.file.*;
+import java.util.*;
+
+/** End-to-end assertions: process success alone does not prove script indexing. */
+public class ScriptProof {
+  public static void main(String[] args) throws Exception {
+    var index = Scip.Index.parseFrom(Files.readAllBytes(Path.of(args[0])));
+    var documents = new HashMap<String, Scip.Document>();
+    for (var document : index.getDocumentsList()) documents.put(document.getRelativePath(), document);
+    for (String path : List.of("settings.gradle.kts", "build.gradle.kts", "child/build.gradle.kts")) {
+      var document = documents.get(path);
+      if (document == null || document.getOccurrencesCount() == 0)
+        throw new AssertionError("Missing compiler-backed script: " + path);
+      for (var symbol : document.getSymbolsList()) {
+        if (symbol.getDisplayName().equals("host") || symbol.getDisplayName().equals("$$result"))
+          throw new AssertionError("Synthetic script field materialized: " + symbol.getSymbol());
+      }
+    }
+    var build = documents.get("build.gradle.kts");
+    if (build.getOccurrencesList().stream().noneMatch(o -> o.getSymbol().contains("RepositoryHandler#mavenCentral")))
+      throw new AssertionError("Missing resolved Gradle API call");
+    if (build.getSymbolsList().stream().noneMatch(s -> s.getDisplayName().equals("count") && s.getKind() == Scip.SymbolInformation.Kind.Variable))
+      throw new AssertionError("Compiler must identify local variable kinds");
+    var greeting = build.getOccurrencesList().stream().filter(o -> (o.getSymbolRoles() & 1) != 0 && o.getRange(0) == 2 && o.getRange(1) == 4).findFirst().orElseThrow();
+    if (build.getOccurrencesList().stream().noneMatch(o -> (o.getSymbolRoles() & 1) == 0 && o.getSymbol().equals(greeting.getSymbol())))
+      throw new AssertionError("Script property reference does not resolve to its definition");
+    var child = documents.get("child/build.gradle.kts");
+    var childGreeting = child.getOccurrencesList().stream().filter(o -> (o.getSymbolRoles() & 1) != 0 && o.getRange(0) == 0 && o.getRange(1) == 4).findFirst().orElseThrow();
+    if (childGreeting.getSymbol().equals(greeting.getSymbol()))
+      throw new AssertionError("Separate script members collide");
+    System.out.println("PASS: scripts, Gradle API calls, local definition/reference, no synthetic fields");
+  }
+}
