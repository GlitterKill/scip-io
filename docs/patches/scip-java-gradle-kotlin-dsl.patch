+param(
+    [Parameter(Mandatory)] [string] $Pack,
+    [Parameter(Mandatory)] [string] $GradleHome,
+    [Parameter(Mandatory)] [string] $MavenRepository
+)
+$ErrorActionPreference = 'Stop'
+$Pack = (Resolve-Path $Pack).Path
+$fixture = Join-Path $env:TEMP ("scip scripts ' regression " + [guid]::NewGuid())
+New-Item -ItemType Directory -Path $fixture | Out-Null
+Copy-Item "$PSScriptRoot/fixture/*" $fixture -Recurse
+$originalJavaOptions = $env:JAVA_TOOL_OPTIONS
+$originalOS = $env:OS
+try {
+    $env:OS = 'Windows_NT'
+    $env:JAVA_TOOL_OPTIONS = '-Dmaven.repo.local="' + (Resolve-Path $MavenRepository).Path + '"'
+    & "$GradleHome/bin/gradle.bat" --no-daemon -p $fixture wrapper --gradle-version 9.5.1
+    if ($LASTEXITCODE -ne 0) { throw 'Fixture wrapper failed' }
+    & javac -proc:none -cp "$Pack/lib/*" -d $fixture "$PSScriptRoot/ScriptProof.java"
+    if ($LASTEXITCODE -ne 0) { throw 'SCIP validator compilation failed' }
+    Push-Location $fixture
+    try {
+        # The second run retains Gradle's compiled-script cache; SCIP must still be regenerated.
+        foreach ($run in 1..2) {
+            & "$Pack/bin/scip-java.bat" index --no-cleanup
+            if ($LASTEXITCODE -ne 0) { throw "Generator failed on run $run" }
+            & java -cp "$fixture;$Pack/lib/*" ScriptProof "$fixture/index.scip"
+            if ($LASTEXITCODE -ne 0) { throw "Invalid script SCIP on run $run" }
+        }
+        Add-Content build.gradle.kts 'unresolvedScipRegressionCall()'
+        Remove-Item -LiteralPath "$fixture/index.scip"
+        & "$Pack/bin/scip-java.bat" index --no-cleanup
+        if ($LASTEXITCODE -eq 0 -or (Test-Path "$fixture/index.scip")) {
+            throw 'Failed script compilation must not produce a successful index'
+        }
+    } finally { Pop-Location }
+    Write-Output "PASS: fresh output, warm script cache, compilation failure propagation. Evidence: $fixture"
+} finally {
+    $env:JAVA_TOOL_OPTIONS = $originalJavaOptions
+    $env:OS = $originalOS
+}
