@@ -0,0 +1,16 @@
+package com.sourcegraph.gradle.semanticdb
+
+import java.nio.file.{Files, Path, StandardCopyOption}
+
+/** Extract once per plugin classloader; never resolve an unpublished Maven artifact. */
+object EmbeddedKotlinPlugin {
+  lazy val path: Path = {
+    val resource = getClass.getResourceAsStream("/semanticdb-kotlinc.jar")
+    require(resource != null, "Missing bundled SemanticDB Kotlin plugin")
+    val out = Files.createTempFile("scip-java-kotlin-", ".jar")
+    out.toFile.deleteOnExit()
+    try Files.copy(resource, out, StandardCopyOption.REPLACE_EXISTING)
+    finally resource.close()
+    out
+  }
+}
